            </a>{" "}
            &middot;
            <a href="/reading-takeaways" class="nowrap">
                <img
                    src="/assets/icons/reading-takeaways.svg"
                    alt=""
                    class="icon"
                />
                Reading Takeaways
            </a>{" "}
            &middot;{" "}
            <a href="/about" class="nowrap">
                <img src="/assets/icons/about.svg" alt="" class="icon" />
