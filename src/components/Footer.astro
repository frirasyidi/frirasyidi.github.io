        <h5>
            <a href="/">frirasyidi.com</a>
        </h5>
        <p>{SITE_DESCRIPTION}</p>
    </section>
    <section class="nav-credits" aria-label="Acknowledgements">
        <nav>
            <a href="/" class="nowrap">
                <img src="/assets/icons/home.svg" alt="" class="icon" />
                Home
            </a>{" "}
            &middot;{" "}
            <a href="/writings" class="nowrap">
                <img src="/assets/icons/writings.svg" alt="" class="icon" />
