---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostUrl } from '../lib/postUrl';
import { formatListingDate } from '../lib/formatDate';
import { sortPosts } from '../lib/sortPosts';
import { GITHUB_USERNAME, LINKEDIN_USERNAME, SITE_EMAIL } from '../consts';

const writings = (await getCollection('posts', ({ data }) => data.section === 'writings')).sort(
  sortPosts
);
const readingTakeaways = (
  await getCollection('posts', ({ data }) => data.section === 'reading-takeaways')
).sort(sortPosts);

// Rendered via set:html (rather than JSX) so the icons stay wrapped in <p>
// (required for the img.icon inline CSS rule to apply, matching what
// kramdown produced for these same <big> blocks) and so line-wrapping in
// this file can't silently swallow the spaces between inline elements.
const introHtml = `
<h1 id="hi-my-name-is-fri">Hi! my name is <span class="jump-effect">Fri</span>.</h1>
<p><big>I am a pragmatic problem solver whose passion is to build products and services to learn and improve people’s lives.</big></p>
<p><big>To make sure the solution is useful, I do various things: <span class="nowrap"><img src="/assets/icons/research.svg" alt="" class="icon" /><em>research</em></span>, <span class="nowrap"><img src="/assets/icons/design.svg" alt="" class="icon" /><em>design</em></span>, <span class="nowrap"><img src="/assets/icons/code.svg" alt="" class="icon" /><em>develop</em></span>, <span class="nowrap"><img src="/assets/icons/test.svg" alt="" class="icon" /><em>test</em></span>, <span class="nowrap"><img src="/assets/icons/track.svg" alt="" class="icon" /><em>track</em></span>, and <span class="nowrap"><img src="/assets/icons/lead.svg" alt="" class="icon" /><em>lead</em></span>; utilizing an <span class="nowrap"><img src="/assets/icons/iterative.svg" alt="" class="icon" /><em>iterative</em></span> and <span class="nowrap"><img src="/assets/icons/human-centric.svg" alt="" class="icon" /><em>human centric</em></span> approach.</big></p>
<p><big>If you’re interested, feel free to connect with me through my <a href="https://github.com/${GITHUB_USERNAME}" class="nowrap"><img src="/assets/social-media/github.svg" alt="" class="icon" />Github</a>, <a href="https://linkedin.com/in/${LINKEDIN_USERNAME}" class="nowrap"><img src="/assets/social-media/linkedin.svg" alt="" class="icon" />Linkedin</a>, or <a href="mailto:${SITE_EMAIL}" class="nowrap"><img src="/assets/social-media/email.svg" alt="" class="icon" />email</a>.</big></p>
<h2 id="i-also-write-mostly-around-crafting-software">I also <span class="nowrap"><img src="/assets/icons/writings.svg" alt="" class="icon" />write</span>, mostly around crafting <span class="nowrap"><img src="/assets/icons/software.svg" alt="" class="icon" />software</span></h2>
`;
---

<BaseLayout title="Home">
  <Fragment set:html={introHtml} />

  <h3 id="thoughts-and-ideas">Thoughts and ideas</h3>

  <p>I hope you find something interesting!</p>

  <table class="with-row-counter mobile-friendly listing-table">
    <tbody>
      {writings.slice(0, 5).map((post) => (
        <tr>
          <td
            ><strong
              ><time datetime={post.data.date.toISOString()}
                set:html={formatListingDate(post.data.date).replaceAll(' ', '&nbsp;')}
              /></strong
            ></td
          >
          <td
            ><a href={getPostUrl(post)}>{post.data.title}</a><br />{post.data.description}</td
          >
        </tr>
      ))}
    </tbody>
  </table>

  {writings.length > 5 && (
    <p>
      <a href="/writings"
        >See more <span class="nowrap"
          ><img src="/assets/icons/writings.svg" alt="" class="icon" />writings</span
        > →</a
      >
    </p>
  )}

  <h3 id="reading-takeaways">Reading takeaways</h3>

  <p>
    Keep in mind that <em>these are not book summaries</em>. My goal is to help
    other learners to gain what I get from, my understanding of, and my views on
    the informations provided in the original source.
  </p>

  <table class="with-row-counter mobile-friendly listing-table">
    <tbody>
      {readingTakeaways.slice(0, 5).map((post) => (
        <tr>
          <td
            ><strong
              ><time datetime={post.data.date.toISOString()}
                set:html={formatListingDate(post.data.date).replaceAll(' ', '&nbsp;')}
              /></strong
            ></td
          >
          <td
            ><a href={getPostUrl(post)}>{post.data.title}</a><br />{post.data.description}</td
          >
        </tr>
      ))}
    </tbody>
  </table>

  {readingTakeaways.length > 5 && (
    <p>
      <a href="/reading-takeaways"
        >See more <span class="nowrap"
          ><img src="/assets/icons/reading-takeaways.svg" alt="" class="icon" />reading
          takeaways</span
        > →</a
      >
    </p>
  )}
</BaseLayout>
