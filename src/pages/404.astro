---
import '../styles/global.scss';
import SEO from '../components/SEO.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title="Page not found" />
    <link rel="stylesheet" href="/assets/css/modern-normalize.css" />
    <style>
      html,
      body {
        height: 100%;
      }
      body {
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .container {
        max-width: 600px;
        text-align: center;
      }
      h1 {
        margin: 30px 0;
        font-size: 4em;
        line-height: 1.2;
        letter-spacing: -1px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1><small>...ᕕ( ╯°□° )ᕗ</small> 404</h1>

      <p><strong>Whoops, you've ventured into the unknown.</strong></p>
      <p>
        No worries, you can <a href="/">click here to go back home</a> and reorient
        yourself before going for another adventure in this site.
      </p>
    </div>
  </body>
</html>
